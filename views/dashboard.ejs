<%- include('layout/header') %>

<!-- Top Statistics Cards Grid -->
<div class="stats-grid">
  <!-- Total Products -->
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Total Products</span>
      <div class="stat-icon icon-blue">
        <i class="fas fa-boxes-stacked"></i>
      </div>
    </div>
    <div class="stat-value"><%= stats.totalProducts %></div>
    <div class="stat-footer">
      <i class="fas fa-cubes"></i>
      <span><%= stats.totalQuantity %> total units in inventory</span>
    </div>
  </div>

  <!-- In Stock Products -->
  <div class="stat-card card-success">
    <div class="stat-header">
      <span class="stat-title">In Stock</span>
      <div class="stat-icon icon-emerald">
        <i class="fas fa-circle-check"></i>
      </div>
    </div>
    <div class="stat-value" style="color: #34d399;"><%= stats.inStockCount %></div>
    <div class="stat-footer">
      <span class="badge badge-in-stock">&ge; 10 Units</span>
      <span>Safe stock levels</span>
    </div>
  </div>

  <!-- Low Stock Products (< 10) - CRITICAL REQUIREMENT HIGHLIGHTED IN RED -->
  <div class="stat-card card-danger">
    <div class="stat-header">
      <span class="stat-title" style="color: #f87171;">Low Stock Alert</span>
      <div class="stat-icon icon-red">
        <i class="fas fa-triangle-exclamation"></i>
      </div>
    </div>
    <div class="stat-value red-value"><%= stats.lowStockCount %></div>
    <div class="stat-footer">
      <span class="badge badge-low-stock">&lt; 10 Units</span>
      <span style="color: #fca5a5; font-weight: 600;">Requires Reordering</span>
    </div>
  </div>

  <!-- Sold Out Products -->
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Sold Out</span>
      <div class="stat-icon icon-slate">
        <i class="fas fa-box-open"></i>
      </div>
    </div>
    <div class="stat-value" style="color: #94a3b8;"><%= stats.soldOutCount %></div>
    <div class="stat-footer">
      <span class="badge badge-sold-out">0 Units</span>
      <span>Out of stock</span>
    </div>
  </div>

  <!-- Total Store Revenue -->
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Total Revenue</span>
      <div class="stat-icon icon-purple">
        <i class="fas fa-indian-rupee-sign"></i>
      </div>
    </div>
    <div class="stat-value" style="color: #7c3aed;">₹<%= stats.totalRevenue.toFixed(2) %></div>
    <div class="stat-footer">
      <i class="fas fa-receipt"></i>
      <span><%= stats.totalInvoices %> total sales transactions</span>
    </div>
  </div>

  <!-- Today's Revenue -->
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Today's Sales</span>
      <div class="stat-icon icon-blue">
        <i class="fas fa-calendar-day"></i>
      </div>
    </div>
    <div class="stat-value" style="color: #0284c7;">₹<%= stats.todayRevenue.toFixed(2) %></div>
    <div class="stat-footer">
      <i class="fas fa-bag-shopping"></i>
      <span><%= stats.todayInvoices %> bills today</span>
    </div>
  </div>
</div>

<!-- Main Action Banner -->
<div style="background: linear-gradient(135deg, #eef2ff, #f8fafc); border: 1px solid #c7d2fe; border-radius: var(--radius-lg); padding: 24px 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; box-shadow: var(--shadow-sm);">
  <div>
    <h2 style="font-size: 18px; font-weight: 800; color: var(--text-main); margin-bottom: 4px;">Hardware Shop Point of Sale & Billing</h2>
    <p style="color: var(--text-muted); font-size: 14px;">Instant multi-item checkout with custom discount percentages and one-click PDF bill generation.</p>
  </div>
  <div style="display: flex; gap: 12px;">
    <a href="/sales/new" class="btn btn-primary btn-lg">
      <i class="fas fa-cash-register"></i> Open Billing Counter
    </a>
    <a href="/reports/sales" class="btn btn-outline btn-lg">
      <i class="fas fa-chart-pie"></i> View Sales Report
    </a>
  </div>
</div>

<!-- Two Columns: Urgent Low Stock & Recent Sales -->
<div class="dashboard-widgets-grid">
  
  <!-- Left Column: Low Stock Products (< 10) Alert Box -->
  <div class="panel" style="border-color: #fecaca;">
    <div class="panel-header" style="background: #fef2f2;">
      <div class="panel-title" style="color: #dc2626;">
        <i class="fas fa-triangle-exclamation"></i>
        <span>Low Stock Alert (&lt; 10 Units)</span>
      </div>
      <a href="/products?status=low_stock" class="btn btn-danger btn-sm">
        View All (<%= stats.lowStockCount %>)
      </a>
    </div>

    <div class="table-responsive">
      <table class="custom-table">
        <thead>
          <tr>
            <th>Product Name</th>
            <th>Category</th>
            <th>Stock Left</th>
            <th>Price</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (lowStockAlerts && lowStockAlerts.length > 0) { %>
            <% lowStockAlerts.forEach(item => { %>
              <tr class="row-low-stock">
                <td>
                  <div style="font-weight: 700; color: var(--text-main);"><%= item.name %></div>
                  <div style="font-size: 11px; color: var(--text-dim);"><%= item.sku %></div>
                </td>
                <td>
                  <span class="badge badge-category"><%= item.category %></span>
                </td>
                <td>
                  <!-- RED COLOR DISPLAY FOR QUANTITY < 10 -->
                  <span class="quantity-text-red">
                    <i class="fas fa-arrow-down" style="font-size: 11px;"></i>
                    <%= item.quantity %> <%= item.unit %>
                  </span>
                </td>
                <td style="font-weight: 700; color: var(--text-main);">₹<%= item.unitPrice.toFixed(2) %></td>
                <td>
                  <button type="button" 
                          class="btn btn-outline btn-sm btn-open-restock" 
                          data-id="<%= item._id %>" 
                          data-name="<%= item.name %>" 
                          data-stock="<%= item.quantity %>">
                    <i class="fas fa-plus"></i> Restock
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 32px; color: #059669;">
                <i class="fas fa-circle-check" style="font-size: 24px; margin-bottom: 8px; display: block;"></i>
                All products have healthy inventory levels (&ge; 10 units)!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right Column: Recent Sales Invoices -->
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">
        <i class="fas fa-receipt"></i>
        <span>Recent Sales & Bills</span>
      </div>
      <a href="/sales" class="btn btn-outline btn-sm">
        All Sales
      </a>
    </div>

    <div class="table-responsive">
      <table class="custom-table">
        <thead>
          <tr>
            <th>Invoice #</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Total</th>
            <th>Bill PDF</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentSales && recentSales.length > 0) { %>
            <% recentSales.forEach(sale => { %>
              <tr>
                <td>
                  <a href="/sales/<%= sale._id %>" style="color: var(--primary); font-weight: 700; text-decoration: none;">
                    <%= sale.invoiceNumber %>
                  </a>
                  <div style="font-size: 11px; color: var(--text-dim);">
                    <%= new Date(sale.createdAt).toLocaleDateString() %>
                  </div>
                </td>
                <td>
                  <div style="color: var(--text-main); font-weight: 600;"><%= sale.customerName %></div>
                  <div style="font-size: 11px; color: var(--text-dim);"><%= sale.paymentMethod %></div>
                </td>
                <td>
                  <% const dashItemQty = sale.items.reduce((sum, i) => sum + (Number(i.quantity) || 0), 0); %>
                  <span class="badge" style="background: #f1f5f9; color: #475569; font-weight: 700;">
                    <%= dashItemQty %> <%= dashItemQty === 1 ? 'item' : 'items' %>
                  </span>
                </td>
                <td>
                  <div style="font-weight: 800; color: var(--text-main);">₹<%= sale.grandTotal.toFixed(2) %></div>
                  <% if (sale.discountPercentage > 0) { %>
                    <span style="font-size: 11px; color: #0284c7; font-weight: 600;">(<%= sale.discountPercentage %>% off)</span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 6px;">
                    <a href="/sales/<%= sale._id %>" class="btn btn-outline btn-sm" title="View Bill" style="padding: 5px 9px;">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a href="/sales/<%= sale._id %>/pdf" class="btn btn-primary btn-sm" title="Download PDF" style="padding: 5px 9px;">
                      <i class="fas fa-file-pdf"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 32px; color: var(--text-dim);">
                No sales recorded yet. Click "Sell Product" to make your first sale!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('layout/footer') %>
