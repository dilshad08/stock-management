      </div><!-- /content-body -->
    </main><!-- /app-main -->
  </div><!-- /app-container -->

  <!-- Quick Restock Modal -->
  <div id="restockModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45); backdrop-filter: blur(4px); z-index: 999; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); width: 100%; max-width: 440px; box-shadow: var(--shadow-lg); overflow: hidden;">
      <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
          <i class="fas fa-boxes-packing" style="color: var(--primary);"></i>
          Quick Restock Product
        </h3>
        <button type="button" class="close-modal" style="background: none; border: none; color: var(--text-dim); font-size: 18px; cursor: pointer;">&times;</button>
      </div>

      <form id="restockForm" method="POST" action="">
        <div style="padding: 24px;">
          <div style="margin-bottom: 16px;">
            <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase;">Product</div>
            <div id="restockProductName" style="font-size: 16px; font-weight: 700; color: var(--text-main); margin-top: 2px;"></div>
          </div>

          <div style="margin-bottom: 20px; display: flex; justify-content: space-between; background: var(--bg-body); padding: 12px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
            <span style="font-size: 13px; color: var(--text-muted);">Current Available Stock:</span>
            <span id="restockCurrentStock" style="font-weight: 800; color: var(--primary);"></span>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="restockQuantity">Additional Quantity to Add:</label>
            <input type="number" id="restockQuantity" name="quantity" class="form-control" min="1" required placeholder="e.g. 20" style="font-size: 16px; font-weight: 700;" />
          </div>
        </div>

        <div style="padding: 16px 24px; background: var(--bg-body); border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 12px;">
          <button type="button" class="btn btn-outline close-modal">Cancel</button>
          <button type="submit" class="btn btn-success">
            <i class="fas fa-plus"></i> Add to Stock
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/js/main.js"></script>
</body>
</html>
