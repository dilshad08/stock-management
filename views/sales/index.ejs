<%- include('../layout/header') %>

<!-- Sales Metrics Cards -->
<div class="stats-grid" style="margin-bottom: 24px;">
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Total Invoices</span>
      <div class="stat-icon icon-blue"><i class="fas fa-file-invoice"></i></div>
    </div>
    <div class="stat-value"><%= stats.totalSales %></div>
    <div class="stat-footer">
      <span>Completed billing transactions</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Gross Sales</span>
      <div class="stat-icon icon-emerald"><i class="fas fa-coins"></i></div>
    </div>
    <div class="stat-value" style="color: #059669;">₹<%= (stats.totalSubtotal || 0).toFixed(2) %></div>
    <div class="stat-footer">
      <span>Before discounts</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Discounts Granted</span>
      <div class="stat-icon icon-cyan"><i class="fas fa-tags"></i></div>
    </div>
    <div class="stat-value" style="color: #0284c7;">₹<%= (stats.totalDiscount || 0).toFixed(2) %></div>
    <div class="stat-footer">
      <span>Total customer savings</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-title">Net Revenue</span>
      <div class="stat-icon icon-purple"><i class="fas fa-indian-rupee-sign"></i></div>
    </div>
    <div class="stat-value" style="color: #7c3aed;">₹<%= (stats.totalRevenue || 0).toFixed(2) %></div>
    <div class="stat-footer">
      <span>Collected revenue</span>
    </div>
  </div>
</div>

<!-- Sales Invoices Panel -->
<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <i class="fas fa-receipt"></i>
      <span>Hardware Sales & Invoices History</span>
      <span class="badge" style="background: #f1f5f9; color: #475569;">
        <%= typeof pagination !== 'undefined' ? pagination.totalCount : sales.length %> records
      </span>
    </div>

    <a href="/sales/new" class="btn btn-primary">
      <i class="fas fa-plus"></i> Create New Sale
    </a>
  </div>

  <div class="panel-body" style="padding-bottom: 0;">
    <!-- Filter Bar -->
    <form method="GET" action="/sales" class="filter-bar">
      <!-- Search -->
      <div style="display: flex; gap: 8px; flex: 1; max-width: 380px;">
        <input 
          type="text" 
          name="search" 
          class="form-control" 
          placeholder="Search invoice #, customer name, phone..." 
          value="<%= currentFilter.search %>"
        />
        <button type="submit" class="btn btn-outline" style="padding: 0 16px;">
          <i class="fas fa-search"></i>
        </button>
      </div>

      <!-- Date Range Filter Tabs -->
      <div class="filter-group">
        <a href="/sales?search=<%= currentFilter.search %>&dateRange=all" 
           class="filter-tab <%= currentFilter.dateRange === 'all' ? 'active' : '' %>">
          All Time
        </a>
        <a href="/sales?search=<%= currentFilter.search %>&dateRange=today" 
           class="filter-tab <%= currentFilter.dateRange === 'today' ? 'active' : '' %>">
          Today
        </a>
        <a href="/sales?search=<%= currentFilter.search %>&dateRange=week" 
           class="filter-tab <%= currentFilter.dateRange === 'week' ? 'active' : '' %>">
          Last 7 Days
        </a>
        <a href="/sales?search=<%= currentFilter.search %>&dateRange=month" 
           class="filter-tab <%= currentFilter.dateRange === 'month' ? 'active' : '' %>">
          This Month
        </a>
      </div>
    </form>
  </div>

  <!-- Invoices Table -->
  <div class="table-responsive">
    <table class="custom-table">
      <thead>
        <tr>
          <th>Invoice # & Date</th>
          <th>Customer</th>
          <th>Items Purchased</th>
          <th>Subtotal</th>
          <th>Discount</th>
          <th>Grand Total</th>
          <th>Payment</th>
          <th style="text-align: right;">Bill & PDF</th>
        </tr>
      </thead>
      <tbody>
        <% if (sales && sales.length > 0) { %>
          <% sales.forEach(sale => { %>
            <tr>
              <td>
                <a href="/sales/<%= sale._id %>" style="color: var(--primary); font-weight: 700; text-decoration: none; font-size: 14px;">
                  <%= sale.invoiceNumber %>
                </a>
                <div style="font-size: 11px; color: var(--text-dim);">
                  <%= new Date(sale.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </div>
                <% if (sale.status === 'returned' || sale.refundAmount > 0) { %>
                  <span class="badge" style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; font-size: 10px; padding: 2px 6px; margin-top: 3px;">
                    <i class="fas fa-rotate-left"></i> Returned (-₹<%= (sale.refundAmount || 0).toFixed(2) %>)
                  </span>
                <% } else if (sale.status === 'modified') { %>
                  <span class="badge" style="background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; font-size: 10px; padding: 2px 6px; margin-top: 3px;">
                    <i class="fas fa-pen-to-square"></i> Modified
                  </span>
                <% } %>
              </td>

              <td>
                <div style="font-weight: 700; color: var(--text-main);"><%= sale.customerName %></div>
                <div style="font-size: 11px; color: var(--text-dim);"><%= sale.customerPhone || 'Walk-in' %></div>
              </td>

              <td>
                <% 
                  const totalPurchasedQty = sale.items.reduce((sum, i) => sum + (Number(i.quantity) || 0), 0);
                  const totalReturnedQty = sale.items.reduce((sum, i) => sum + (Number(i.returnedQuantity) || 0), 0);
                  const originalTotalQty = sale.items.reduce((sum, i) => sum + (Number(i.originalQuantity) || Number(i.quantity) || 0), 0);
                  const itemsSummaryText = sale.items.map(i => `${i.quantity}x ${i.productName}`).slice(0, 2).join(', ');
                %>
                <div style="display: flex; flex-direction: column; gap: 2px;">
                  <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                    <span style="font-weight: 700; color: var(--text-main); font-size: 14px;">
                      <%= totalPurchasedQty %> <%= totalPurchasedQty === 1 ? 'item' : 'items' %>
                    </span>
                    <% if (totalReturnedQty > 0) { %>
                      <span class="badge" style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; font-size: 10px; padding: 1px 5px;">
                        <%= totalReturnedQty %> returned
                      </span>
                    <% } %>
                    <% if (sale.items.length > 1) { %>
                      <span style="font-size: 11px; color: var(--text-dim);">(<%= sale.items.length %> products)</span>
                    <% } %>
                  </div>
                  <% if (totalReturnedQty > 0 && originalTotalQty !== totalPurchasedQty) { %>
                    <div style="font-size: 11px; color: var(--text-dim);">
                      Original: <%= originalTotalQty %> items
                    </div>
                  <% } %>
                  <div style="font-size: 11px; color: var(--text-dim); margin-top: 1px;">
                    <%= itemsSummaryText %><%= sale.items.length > 2 ? '...' : '' %>
                  </div>
                </div>
              </td>

              <td style="color: var(--text-muted); font-weight: 600;">
                ₹<%= sale.subtotal.toFixed(2) %>
              </td>

              <td>
                <% if (sale.discountPercentage > 0) { %>
                  <span class="badge" style="background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;">
                    <%= sale.discountPercentage %>% (-₹<%= sale.discountAmount.toFixed(2) %>)
                  </span>
                <% } else { %>
                  <span style="color: var(--text-dim); font-size: 12px;">None (0%)</span>
                <% } %>
              </td>

              <td>
                <div style="font-weight: 800; color: var(--text-main); font-size: 15px;">
                  ₹<%= sale.grandTotal.toFixed(2) %>
                </div>
              </td>

              <td>
                <span class="badge" style="background: #f1f5f9; color: #475569;">
                  <%= sale.paymentMethod %>
                </span>
              </td>

              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <a href="/sales/<%= sale._id %>" class="btn btn-outline btn-sm" title="View Bill">
                    <i class="fas fa-eye"></i> View
                  </a>
                  <a href="/sales/<%= sale._id %>/edit" class="btn btn-outline btn-sm" title="Edit Bill / Return Items" style="color: var(--primary); border-color: #cbd5e1;">
                    <i class="fas fa-rotate-left"></i> Return
                  </a>
                  <!-- CRITICAL USER REQUIREMENT: GENERATE PDF FOR THE BILL -->
                  <a href="/sales/<%= sale._id %>/pdf" class="btn btn-primary btn-sm" title="Download PDF Invoice">
                    <i class="fas fa-file-pdf"></i> PDF
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 48px; color: var(--text-dim);">
              <i class="fas fa-receipt" style="font-size: 36px; margin-bottom: 12px; display: block;"></i>
              No sales found for the selected filter.
              <div style="margin-top: 12px;">
                <a href="/sales/new" class="btn btn-primary btn-sm">Make a Sale</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Component -->
  <%- include('../layout/pagination', {
    pagination: pagination,
    baseUrl: '/sales',
    queryParams: currentFilter,
    itemName: 'invoices'
  }) %>
</div>

<%- include('../layout/footer') %>
