<%- include('../layout/header') %>

<!-- Top Bill Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; max-width: 820px; margin: 0 auto 20px; flex-wrap: wrap; gap: 12px;">
  <a href="/sales" class="btn btn-outline">
    <i class="fas fa-arrow-left"></i> Back to Sales List
  </a>

  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
    <!-- Edit Bill / Return Items Button -->
    <a href="/sales/<%= sale._id %>/edit" class="btn btn-outline" style="border-color: #38bdf8; color: #38bdf8;">
      <i class="fas fa-rotate-left"></i> Edit Bill / Return Items
    </a>

    <!-- Print Button -->
    <button type="button" class="btn btn-outline" onclick="window.print()">
      <i class="fas fa-print"></i> Print Bill
    </button>

    <!-- Download PDF Invoice -->
    <a href="/sales/<%= sale._id %>/pdf" class="btn btn-primary" download>
      <i class="fas fa-file-pdf"></i> Download PDF Invoice
    </a>

    <a href="/sales/new" class="btn btn-success">
      <i class="fas fa-plus"></i> New Sale
    </a>
  </div>
</div>

<!-- Professional Printable Invoice Document -->
<div class="invoice-paper" id="invoicePrintArea">
  <!-- Invoice Header -->
  <div class="invoice-header">
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
        <div style="width: 36px; height: 36px; background: #4f46e5; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px;">
          <i class="fas fa-tools"></i>
        </div>
        <span class="invoice-title"><%= typeof shopName !== 'undefined' ? shopName : 'HARDWARE HUB' %></span>
      </div>
      <div style="font-size: 13px; color: var(--text-dim); line-height: 1.5;">
        <div>Industrial Tools, Electrical & Plumbing Supplies</div>
        <div>Ruigola, Madhopara, Purnia - 854301</div>
        <div>Phone: +91 84495 90494</div>
      </div>
    </div>

    <div style="text-align: right;">
      <% if (sale.status === 'returned' || sale.refundAmount > 0) { %>
        <span style="display: inline-block; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; font-weight: 700; font-size: 11px; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 8px; margin-right: 6px;">
          <i class="fas fa-rotate-left"></i> Return Processed
        </span>
      <% } else if (sale.status === 'modified') { %>
        <span style="display: inline-block; background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; font-weight: 700; font-size: 11px; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 8px; margin-right: 6px;">
          <i class="fas fa-pen-to-square"></i> Modified
        </span>
      <% } %>

      <span style="display: inline-block; background: var(--primary); color: #fff; font-weight: 700; font-size: 12px; padding: 4px 12px; border-radius: 4px; text-transform: uppercase; margin-bottom: 8px;">
        Tax Invoice
      </span>
      <div style="font-size: 16px; font-weight: 800; color: var(--primary);"><%= sale.invoiceNumber %></div>
      <div style="font-size: 13px; color: var(--text-dim); margin-top: 4px;">
        Date: <%= new Date(sale.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
      </div>
      <div style="font-size: 13px; color: var(--text-dim);">
        Payment: <strong style="color: var(--text-main);"><%= sale.paymentMethod %></strong>
      </div>
    </div>
  </div>

  <!-- Customer Details Block -->
  <div class="invoice-customer-card">
    <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px;">Customer Information</div>
    <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
      <div>
        <div class="invoice-customer-name" style="font-size: 15px; font-weight: 700; color: var(--text-main);"><%= sale.customerName %></div>
        <div style="font-size: 13px; color: var(--text-dim);"><%= sale.customerPhone ? 'Phone: ' + sale.customerPhone : 'Walk-in Customer' %></div>
      </div>
      <% if (sale.customerAddress) { %>
        <div style="font-size: 13px; color: var(--text-dim); max-width: 280px; text-align: right;">
          <strong style="color: var(--text-main);">Address:</strong> <%= sale.customerAddress %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Items Table -->
  <table class="invoice-table">
    <thead>
      <tr>
        <th style="width: 30px; text-align: center;">#</th>
        <th>Item Description</th>
        <th>SKU</th>
        <th style="text-align: center;">Qty</th>
        <th style="text-align: right;">Unit Price</th>
        <th style="text-align: right;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% sale.items.forEach((item, index) => { %>
        <tr>
          <td style="text-align: center; color: var(--text-muted);"><%= index + 1 %></td>
          <td>
            <div style="font-weight: 700; color: var(--text-main);"><%= item.productName %></div>
          </td>
          <td style="font-family: var(--font-mono); font-size: 12px; color: var(--primary);"><%= item.sku %></td>
          <td style="text-align: center; font-weight: 700; color: var(--text-main);">
            <%= item.quantity %> <%= item.unit %>
            <% if (item.returnedQuantity && item.returnedQuantity > 0) { %>
              <div style="font-size: 11px; color: #dc2626; font-weight: 600;">(<%= item.returnedQuantity %> returned)</div>
            <% } %>
          </td>
          <td style="text-align: right; color: var(--text-muted);">₹<%= item.unitPrice.toFixed(2) %></td>
          <td style="text-align: right; font-weight: 700; color: var(--text-main);">₹<%= item.subtotal.toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Calculation & Totals -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 24px; flex-wrap: wrap; gap: 20px;">
    <!-- Left: Notes & Terms -->
    <div style="flex: 1; max-width: 400px;">
      <% if (sale.notes) { %>
        <div style="font-size: 12px; color: var(--text-dim); margin-bottom: 12px;">
          <strong style="color: var(--text-main);">Notes:</strong> <%= sale.notes %>
        </div>
      <% } %>

      <div style="font-size: 11px; color: var(--text-muted); line-height: 1.5; border-top: 1px solid var(--border-color); padding-top: 10px;">
        <div style="color: var(--text-main);"><strong>Terms & Conditions:</strong></div>
        <div>1. Warranty covered by respective product manufacturers.</div>
        <div>2. Goods once sold can be returned/exchanged within 7 days with bill.</div>
      </div>
    </div>

    <!-- Right: Subtotal, Discount, Grand Total -->
    <div class="invoice-totals">
      <div class="invoice-total-row">
        <span>Subtotal:</span>
        <span style="font-weight: 700; color: var(--text-main);">₹<%= sale.subtotal.toFixed(2) %></span>
      </div>

      <% if (sale.discountPercentage > 0) { %>
        <div class="invoice-total-row" style="color: #0284c7; font-weight: 600;">
          <span>Discount (<%= sale.discountPercentage %>%):</span>
          <span>-₹<%= sale.discountAmount.toFixed(2) %></span>
        </div>
      <% } else { %>
        <div class="invoice-total-row">
          <span>Discount (0%):</span>
          <span>₹0.00</span>
        </div>
      <% } %>

      <% if (sale.taxAmount > 0) { %>
        <div class="invoice-total-row">
          <span>Tax:</span>
          <span>+₹<%= sale.taxAmount.toFixed(2) %></span>
        </div>
      <% } %>

      <div class="invoice-grand-total invoice-total-row">
        <span>Total Amount:</span>
        <span style="color: var(--primary); font-size: 18px; font-weight: 800;">₹<%= sale.grandTotal.toFixed(2) %></span>
      </div>

      <% if (sale.refundAmount && sale.refundAmount > 0) { %>
        <div class="invoice-total-row" style="color: #059669; font-weight: 700; padding-top: 4px; font-size: 13px;">
          <span>Refund Paid to Customer:</span>
          <span>-₹<%= sale.refundAmount.toFixed(2) %></span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Bill Footer -->
  <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: flex-end; font-size: 12px; color: var(--text-dim);">
    <div>
      Thank you for your business at <strong style="color: var(--text-main);"><%= typeof shopName !== 'undefined' ? shopName : 'HARDWARE HUB' %></strong>!
    </div>
    <div style="text-align: right;">
      <div style="border-bottom: 1px solid #cbd5e1; width: 160px; margin-bottom: 4px;"></div>
      <div>Authorized Signatory</div>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>
