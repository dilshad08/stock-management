<%- include('../layout/header') %>

<div style="max-width: 800px; margin: 0 auto; width: 100%;">
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">
        <i class="fas fa-edit" style="color: var(--primary);"></i>
        <span>Edit Product: <%= product.name %></span>
      </div>
      <a href="/products" class="btn btn-outline btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Inventory
      </a>
    </div>

    <form method="POST" action="/products/<%= product._id %>/edit" class="panel-body">
      <!-- Row 1: Product Name & SKU -->
      <div class="form-row">
        <div class="form-group" style="flex: 2;">
          <label class="form-label" for="name" style="display: flex; align-items: center; justify-content: space-between;">
            <span>Product Name *</span>
            <span style="font-size: 11px; font-weight: 600; color: var(--primary);"><i class="fas fa-fingerprint"></i> Must Be Unique</span>
          </label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control" 
            required 
            value="<%= product.name %>"
          />
          <span style="font-size: 11px; color: var(--text-dim);">Product name must be unique across all inventory items</span>
        </div>

        <div class="form-group" style="flex: 1;">
          <label class="form-label" for="sku" style="display: flex; align-items: center; justify-content: space-between;">
            <span>SKU / Item Code</span>
            <span style="font-size: 11px; font-weight: 600; color: var(--primary);"><i class="fas fa-lock"></i> Unique Code</span>
          </label>
          <input 
            type="text" 
            id="sku" 
            class="form-control" 
            value="<%= product.sku %>"
            readonly
            style="background-color: #f1f5f9; cursor: not-allowed; font-family: var(--font-mono); font-weight: 700; color: var(--primary);"
            title="Unique SKU cannot be modified."
          />
          <span style="font-size: 11px; color: var(--text-dim);">Fixed unique identifier</span>
        </div>
      </div>

      <!-- Row 2: Category & Unit -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="category" style="display: flex; align-items: center; justify-content: space-between;">
            <span>Category *</span>
            <span style="font-size: 11px; color: var(--text-dim);"><%= categories.length %> categories available</span>
          </label>
          <select id="category" name="category" class="form-control" required>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }); %>
            <% } %>
          </select>
          <span style="font-size: 11px; color: var(--text-dim);">Select standard hardware category</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="unit">Unit of Measure</label>
          <select id="unit" name="unit" class="form-control">
            <option value="pcs" <%= product.unit === 'pcs' ? 'selected' : '' %>>Pieces (pcs)</option>
            <option value="box" <%= product.unit === 'box' ? 'selected' : '' %>>Box (box)</option>
            <option value="kg" <%= product.unit === 'kg' ? 'selected' : '' %>>Kilogram (kg)</option>
            <option value="meter" <%= product.unit === 'meter' ? 'selected' : '' %>>Meter (m)</option>
            <option value="set" <%= product.unit === 'set' ? 'selected' : '' %>>Set (set)</option>
            <option value="packet" <%= product.unit === 'packet' ? 'selected' : '' %>>Packet (pkt)</option>
            <option value="can" <%= product.unit === 'can' ? 'selected' : '' %>>Can / Bottle</option>
          </select>
        </div>
      </div>

      <!-- Row 3: Pricing & Current Stock -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="costPrice">Cost Price (₹) *</label>
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            id="costPrice" 
            name="costPrice" 
            class="form-control" 
            required 
            value="<%= product.costPrice %>"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="unitPrice">Selling Price (₹) *</label>
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            id="unitPrice" 
            name="unitPrice" 
            class="form-control" 
            required 
            value="<%= product.unitPrice %>"
          />
        </div>

        <div class="form-group">
          <% const isLow = product.quantity < 10; %>
          <label class="form-label" for="quantity">Stock Quantity *</label>
          <input 
            type="number" 
            min="0" 
            id="quantity" 
            name="quantity" 
            class="form-control <%= isLow ? 'red-value' : '' %>" 
            required 
            value="<%= product.quantity %>"
          />
          <% if (isLow) { %>
            <span style="font-size: 11px; color: #dc2626; font-weight: 700;">
              <i class="fas fa-exclamation-triangle"></i> Current stock is below 10 units!
            </span>
          <% } %>
        </div>
      </div>

      <!-- Row 4: Description -->
      <div class="form-group">
        <label class="form-label" for="description">Description / Technical Notes</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-control" 
          rows="3"
        ><%= product.description %></textarea>
      </div>

      <!-- Form Actions -->
      <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
        <a href="/products" class="btn btn-outline">Cancel</a>
        <button type="submit" id="submitEditBtn" class="btn btn-primary btn-lg">
          <i class="fas fa-save"></i> Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>
