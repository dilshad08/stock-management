<%- include('../layout/header') %>

<div style="max-width: 800px; margin: 0 auto; width: 100%;">
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">
        <i class="fas fa-plus-circle" style="color: var(--primary);"></i>
        <span>Add New Hardware Product</span>
      </div>
      <a href="/products" class="btn btn-outline btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Inventory
      </a>
    </div>

    <form method="POST" action="/products" class="panel-body">
      <!-- Row 1: Product Name & SKU -->
      <div class="form-row">
        <div class="form-group" style="flex: 2;">
          <label class="form-label" for="name" style="display: flex; align-items: center; justify-content: space-between;">
            <span>Product Name *</span>
            <span style="font-size: 11px; font-weight: 600; color: var(--primary);"><i class="fas fa-fingerprint"></i> Must Be Unique</span>
          </label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control" 
            required 
            placeholder="e.g. Bosch 13mm Impact Drill Machine"
          />
          <span style="font-size: 11px; color: var(--text-dim);">Enter a unique name to identify this hardware product</span>
        </div>

        <div class="form-group" style="flex: 1;">
          <label class="form-label" for="sku" style="display: flex; align-items: center; justify-content: space-between;">
            <span>SKU / Item Code *</span>
            <span style="font-size: 11px; font-weight: 600; color: var(--primary);"><i class="fas fa-lock"></i> Auto Unique</span>
          </label>
          <input 
            type="text" 
            id="sku" 
            name="sku" 
            class="form-control" 
            value="<%= typeof autoSku !== 'undefined' ? autoSku : 'SKU-' + Date.now().toString().slice(-6) %>"
            readonly
            style="text-transform: uppercase; background-color: #f1f5f9; cursor: not-allowed; font-family: var(--font-mono); font-weight: 700; color: var(--primary);"
            title="Auto-generated unique SKU. Non-editable."
          />
          <span style="font-size: 11px; color: var(--text-dim);">System assigns a guaranteed unique SKU code</span>
        </div>
      </div>

      <!-- Row 2: Category & Unit -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="category" style="display: flex; align-items: center; justify-content: space-between;">
            <span>Category *</span>
            <span style="font-size: 11px; color: var(--text-dim);"><%= categories.length %> categories available</span>
          </label>
          <select id="category" name="category" class="form-control" required>
            <option value="">-- Choose Category --</option>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }); %>
            <% } %>
          </select>
          <span style="font-size: 11px; color: var(--text-dim);">Select standard hardware category</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="unit">Unit of Measure</label>
          <select id="unit" name="unit" class="form-control">
            <option value="pcs">Pieces (pcs)</option>
            <option value="box">Box (box)</option>
            <option value="kg">Kilogram (kg)</option>
            <option value="meter">Meter (m)</option>
            <option value="set">Set (set)</option>
            <option value="packet">Packet (pkt)</option>
            <option value="can">Can / Bottle</option>
          </select>
        </div>
      </div>

      <!-- Row 3: Pricing & Initial Stock -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="costPrice">Cost Price (₹) *</label>
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            id="costPrice" 
            name="costPrice" 
            class="form-control" 
            required 
            placeholder="0.00"
          />
          <span style="font-size: 11px; color: var(--text-dim);">Purchase / Wholesale price</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="unitPrice">Selling Price (₹) *</label>
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            id="unitPrice" 
            name="unitPrice" 
            class="form-control" 
            required 
            placeholder="0.00"
          />
          <span style="font-size: 11px; color: var(--text-dim);">Retail price per unit</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="quantity">Initial Stock Quantity *</label>
          <input 
            type="number" 
            min="0" 
            id="quantity" 
            name="quantity" 
            class="form-control" 
            required 
            placeholder="0"
          />
          <span style="font-size: 11px; color: #dc2626; font-weight: 600;">Note: Items &lt; 10 units trigger Low Stock alert</span>
        </div>
      </div>

      <!-- Row 4: Description -->
      <div class="form-group">
        <label class="form-label" for="description">Description / Technical Notes</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-control" 
          rows="3" 
          placeholder="e.g. 550W motor, variable speed control, includes key chuck and auxiliary handle"
        ></textarea>
      </div>

      <!-- Form Actions -->
      <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
        <a href="/products" class="btn btn-outline">Cancel</a>
        <button type="submit" id="submitProductBtn" class="btn btn-primary btn-lg">
          <i class="fas fa-check"></i> Save Product to Inventory
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>
